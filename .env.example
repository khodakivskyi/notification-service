# =============================================================================
# Application
# =============================================================================

# Runtime environment: development | production | test
NODE_ENV=development

# HTTP server port (inside container)
PORT=3001

# Log level: error | warn | info | debug
LOG_LEVEL=info


# =============================================================================
# Authentication
# =============================================================================

# API key for service-to-service authentication
# Leave empty to disable auth
# Generate with: openssl rand -hex 32
API_KEY=your-secret-key


# =============================================================================
# Rate Limiting (optional)
# =============================================================================

# Enable/disable rate limiting
RATE_LIMIT_ENABLED=false

# Redis connection (used only if rate limiting is enabled)
REDIS_URL=redis://redis:6379

# Redis host port (optional, for docker-compose.rate-limit.yml)
REDIS_PORT=6379

# Max requests per duration
RATE_LIMIT_POINTS=100

# Time window in seconds
RATE_LIMIT_DURATION=60

# Block duration in seconds after limit exceeded
RATE_LIMIT_BLOCK_DURATION=60


# =============================================================================
# Database (PostgreSQL)
# =============================================================================

# Used by PostgreSQL container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=notifications
DB_PORT=5432

# Database connection string
# Docker: use service name `db`
# Local: replace `db` with `localhost`
DATABASE_URL=postgresql://postgres:postgres@db:5432/notifications?sslmode=disable


# =============================================================================
# SMTP / Email
# =============================================================================

# SMTP server host
SMTP_HOST=smtp.gmail.com

# SMTP server port
# 587 = TLS, 465 = SSL
SMTP_PORT=587

# Sender email / SMTP username
SMTP_USER=your-email@gmail.com

# SMTP password or app password
SMTP_PASS=your-app-password


# =============================================================================
# RabbitMQ
# =============================================================================

# RabbitMQ connection URL (for app)
# Docker: use service name `rabbitmq`
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# RabbitMQ container credentials (used by RabbitMQ image)
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Outbound delivery queue (email, SMS, push, …)
OUTBOUND_QUEUE_NAME=email_notifications

# Dead Letter Exchange
RABBITMQ_DLX_EXCHANGE=notification.dlx

# Dead Letter Queue
OUTBOUND_DLQ_NAME=email.dlq
OUTBOUND_DLQ_ROUTING_KEY=email.dlq

# Retry queue
OUTBOUND_RETRY_QUEUE_NAME=email.retry

# After how many ms is a message considered expired
RABBITMQ_OUTBOUND_TTL=300000

# Maximum number of messages in the queue
RABBITMQ_OUTBOUND_MAX_LENGTH=10000


# =============================================================================
# Docker / Local overrides
# =============================================================================

# Host port mapping (HOST:CONTAINER)
APP_PORT=3001
